rules_version = '2';

// Cakeita security rules. Paste into Firebase console -> Firestore Database -> Rules -> Publish.
// Data layout and reasons are in src/cloud/data.ts. Payloads are JSON text, re-checked by the app.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUid(uid) { return signedIn() && request.auth.uid == uid; }
    function text(v, max) { return v is string && v.size() <= max; }
    function stamp(v) { return v is string && v.size() <= 40; }
    function menuDoc(slug) { return /databases/$(database)/documents/menus/$(slug); }
    function quoteDoc(id) { return /databases/$(database)/documents/quotes/$(id); }

    // Private bakery: costs, margins, recipes. Only the owner.
    match /bakeries/{uid} {
      allow read, delete: if isUid(uid);
      allow create, update: if isUid(uid)
        && request.resource.data.keys().hasOnly(['data', 'slug', 'updatedAt'])
        && text(request.resource.data.data, 400000)
        && text(request.resource.data.slug, 40)
        && stamp(request.resource.data.updatedAt);
    }

    // Public menu and map pin. Link names (slugs) are first come, first served.
    match /menus/{slug} {
      allow read: if true;
      allow create: if signedIn()
        && slug.matches('^[a-z0-9-]{1,40}$')
        && request.resource.data.ownerUid == request.auth.uid
        && validMenu();
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && validMenu();
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      function validMenu() {
        let d = request.resource.data;
        return d.keys().hasOnly(['ownerUid', 'slug', 'name', 'listed', 'lat', 'lng', 'area', 'deliveryKm', 'menu', 'updatedAt'])
          && d.slug == slug
          && text(d.name, 80)
          && d.listed is bool
          && (d.lat == null || (d.lat is number && d.lat >= -90 && d.lat <= 90))
          && (d.lng == null || (d.lng is number && d.lng >= -180 && d.lng <= 180))
          && text(d.area, 80)
          && d.deliveryKm is number && d.deliveryKm >= 0 && d.deliveryKm <= 100
          && text(d.menu, 100000)
          && stamp(d.updatedAt);
      }
    }

    // Customer -> baker. No account needed to send; only the baker can read.
    match /requests/{id} {
      allow create: if id.matches('^[A-Za-z0-9-]{4,64}$')
        && request.resource.data.keys().hasOnly(['bakerUid', 'slug', 'req', 'createdAt', 'photo', 'notify'])
        && text(request.resource.data.req, 20000)
        // Optional inspo photo: a small JPEG as a data URL (shrunk on the customer's phone).
        // Optional: the customer's phone, to tell them when the quote is ready.
        && (!('notify' in request.resource.data) || text(request.resource.data.notify, 2000))
        && (!('photo' in request.resource.data) || (text(request.resource.data.photo, 400000) && request.resource.data.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
        && stamp(request.resource.data.createdAt)
        && exists(menuDoc(request.resource.data.slug))
        && get(menuDoc(request.resource.data.slug)).data.ownerUid == request.resource.data.bakerUid;
      allow read, delete: if signedIn() && resource.data.bakerUid == request.auth.uid;
      allow update: if false;
    }

    // Baker -> customer. Readable by id only (ids are long and random); never listed.
    match /quotes/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.bakerUid == request.auth.uid
        && validQuote();
      allow update: if signedIn()
        && resource.data.bakerUid == request.auth.uid
        && request.resource.data.bakerUid == request.auth.uid
        && validQuote();
      allow delete: if signedIn() && resource.data.bakerUid == request.auth.uid;

      function validQuote() {
        return request.resource.data.keys().hasOnly(['bakerUid', 'quote', 'updatedAt'])
          && text(request.resource.data.quote, 30000)
          && stamp(request.resource.data.updatedAt);
      }
    }

    // Baker -> customer: photo of the finished cake ("your cake is ready"). Readable by id only,
    // like the quote. Only the baker who owns the quote can write it.
    match /ready/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn()
        && exists(quoteDoc(id))
        && get(quoteDoc(id)).data.bakerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['bakerUid', 'photo', 'at'])
        && request.resource.data.bakerUid == request.auth.uid
        && text(request.resource.data.photo, 400000)
        && request.resource.data.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && stamp(request.resource.data.at);
      allow delete: if signedIn() && resource.data.bakerUid == request.auth.uid;
    }

    // Customer <-> baker chat on one request. The order id is the secret (like quotes), so anyone
    // holding it reads and writes as the customer; only the signed-in baker of that request writes as the baker.
    match /chats/{orderId}/messages/{mid} {
      function ownerOf() {
        return exists(quoteDoc(orderId)) ? get(quoteDoc(orderId)).data.bakerUid
          : (exists(/databases/$(database)/documents/requests/$(orderId)) ? get(/databases/$(database)/documents/requests/$(orderId)).data.bakerUid : null);
      }
      allow read: if true;
      allow create: if mid.matches('^[A-Za-z0-9]{6,64}$')
        && request.resource.data.keys().hasOnly(['from', 'text', 'at', 'bakerUid'])
        && text(request.resource.data.text, 500)
        && request.resource.data.text.size() > 0
        && stamp(request.resource.data.at)
        && request.resource.data.bakerUid != null
        && request.resource.data.bakerUid == ownerOf()
        && (request.resource.data.from == 'customer'
          || (request.resource.data.from == 'baker' && isUid(request.resource.data.bakerUid)));
      allow update: if false;
      allow delete: if signedIn() && resource.data.bakerUid == request.auth.uid;
    }

    // Customer -> baker: "Yes, I'll take it." Only for a quote that exists, only once.
    match /confirmations/{id} {
      allow create: if exists(quoteDoc(id))
        && request.resource.data.keys().hasOnly(['bakerUid', 'conf', 'createdAt'])
        && request.resource.data.bakerUid == get(quoteDoc(id)).data.bakerUid
        && text(request.resource.data.conf, 2000)
        && stamp(request.resource.data.createdAt);
      allow read, delete: if signedIn() && resource.data.bakerUid == request.auth.uid;
      allow update: if false;
    }

    // Customer -> baker: one counter-offer on a quote ("Puwede ba ₱X?"). Same shape as confirmations.
    match /offers/{id} {
      allow create: if exists(quoteDoc(id))
        && request.resource.data.keys().hasOnly(['bakerUid', 'offer', 'createdAt'])
        && request.resource.data.bakerUid == get(quoteDoc(id)).data.bakerUid
        && text(request.resource.data.offer, 1000)
        && stamp(request.resource.data.createdAt);
      allow read, delete: if signedIn() && resource.data.bakerUid == request.auth.uid;
      allow update: if false;
    }

    // Proof for a review: links a signed-in customer to an order the baker quoted (quotes/{orderId})
    // and the customer confirmed (confirmations/{orderId}). Nobody can read it, so the order id
    // (which opens the quote) never becomes public.
    match /reviewTickets/{id} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && id.matches('^[A-Za-z0-9]{20,40}$')
        && request.resource.data.keys().hasOnly(['orderId', 'bakerUid', 'slug', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && text(request.resource.data.orderId, 64)
        && exists(quoteDoc(request.resource.data.orderId))
        && exists(/databases/$(database)/documents/confirmations/$(request.resource.data.orderId))
        && request.resource.data.bakerUid == get(quoteDoc(request.resource.data.orderId)).data.bakerUid
        && request.resource.data.bakerUid != request.auth.uid
        && text(request.resource.data.slug, 40)
        && exists(menuDoc(request.resource.data.slug))
        && get(menuDoc(request.resource.data.slug)).data.ownerUid == request.resource.data.bakerUid
        && stamp(request.resource.data.createdAt);
    }

    // Customer -> everyone: star review, backed by the customer's own review ticket. One per
    // customer per bakery (id = uid_slug), never edited. The reviewer (deleting their account)
    // or a Cakeita admin can remove one; the baker cannot.
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn()
        && id == request.auth.uid + '_' + request.resource.data.slug
        && request.resource.data.keys().hasOnly(['bakerUid', 'slug', 'ticket', 'stars', 'text', 'name', 'createdAt'])
        && text(request.resource.data.ticket, 40)
        && exists(/databases/$(database)/documents/reviewTickets/$(request.resource.data.ticket))
        && get(/databases/$(database)/documents/reviewTickets/$(request.resource.data.ticket)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/reviewTickets/$(request.resource.data.ticket)).data.bakerUid == request.resource.data.bakerUid
        && get(/databases/$(database)/documents/reviewTickets/$(request.resource.data.ticket)).data.slug == request.resource.data.slug
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && text(request.resource.data.text, 300)
        && text(request.resource.data.name, 40)
        && stamp(request.resource.data.createdAt);
      allow update: if false;
      allow delete: if signedIn() && (id.split('_')[0] == request.auth.uid || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Phones a baker turned notifications on for. Readable by exact id (the notify function reads it
    // to send "new request"); a subscription is useless without the server's private key.
    match /push/{uid} {
      allow get: if true;
      allow list: if false;
      allow delete: if isUid(uid);
      allow create, update: if isUid(uid)
        && request.resource.data.keys().hasOnly(['subs', 'updatedAt'])
        && text(request.resource.data.subs, 8000)
        && stamp(request.resource.data.updatedAt);
    }

    // Cakeita team members. Added by hand in the Firebase console (document id = their account id).
    match /admins/{uid} {
      allow get: if isUid(uid);
      allow list, write: if false;
    }

    // Pilot survey answers and feedback. Anyone can send (no account needed); nobody can change
    // or read them except Cakeita admins.
    match /feedback/{id} {
      allow create: if id.matches('^fb-[A-Za-z0-9]{8,40}$')
        && request.resource.data.keys().hasOnly(['kind', 'part', 'ref', 'answers', 'page', 'lang', 'createdAt'])
        && request.resource.data.kind in ['baker', 'customer', 'feedback']
        && request.resource.data.part in [0, 1, 2]
        && text(request.resource.data.ref, 40)
        && text(request.resource.data.answers, 4000)
        && text(request.resource.data.page, 120)
        && text(request.resource.data.lang, 4)
        && stamp(request.resource.data.createdAt);
      allow read: if signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    // A customer's own "My cakes" list.
    match /users/{uid} {
      allow read, delete: if isUid(uid);
      allow create, update: if isUid(uid)
        && request.resource.data.keys().hasOnly(['myRequests', 'updatedAt'])
        && text(request.resource.data.myRequests, 200000)
        && stamp(request.resource.data.updatedAt);
    }
  }
}
