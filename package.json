{
  "name": "cakeita",
  "private": true,
  "version": "1.13.0",
  "description": "Cakeita: budget-first custom cake quotes with a live 3D cake preview for Filipino home bakers.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/run.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cakeita \"node tests/rules.test.mjs\""
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "7.18.5",
    "three": "0.180.0",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "4.3.5",
    "@types/leaflet": "1.9",
    "@types/node": "22.19.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.180.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.10.3",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "playwright": "^1.63.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    },
    "@grpc/grpc-js": "^1.14.7"
  }
}
